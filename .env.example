# CodeDocent configuration — copy to .env and fill in what you have.
# Only ONE runtime credential is needed; run `codedocent doctor` to verify.

# Force a specific runtime (else the first usable one is auto-picked):
# claude-sdk | claude-cli | copilot-cli | gemini-cli | anthropic-api | openai-api
#CODEDOCENT_RUNTIME=

# --- claude-sdk / anthropic-api ---
#ANTHROPIC_API_KEY=
#ANTHROPIC_BASE_URL=            # anthropic-api only; for compatible endpoints

# --- copilot-cli (or rely on `copilot` interactive login) ---
#COPILOT_GITHUB_TOKEN=          # falls back to GH_TOKEN, then GITHUB_TOKEN

# --- gemini-cli (or rely on the CLI's own login) ---
#GEMINI_API_KEY=                # or GOOGLE_API_KEY
#GEMINI_BIN=                    # e.g. path to the Antigravity CLI

# --- openai-api (any OpenAI-compatible endpoint: OpenAI, Azure, vLLM, Ollama…) ---
#OPENAI_API_KEY=
#OPENAI_BASE_URL=               # default https://api.openai.com/v1
#OPENAI_MODEL=                  # required for openai-api unless passed per command
